{
  "name": "approval-firewall-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "next lint"
  },
  "//overrides": "next vendors an old postcss and an old sharp; npm's only offered fix is downgrading Next to 9.x. Both are build-time only here (images are unoptimized, so sharp never runs), but pinning the patched versions clears the advisories without touching Next.",
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  }
}
